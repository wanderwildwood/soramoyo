<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets a made-up answer stand in for the Weather Service's, to see the
     alert screens on a day with no alert anywhere near. Never in a release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name=".alerts.FakeAlerts"
            android:authorities="com.wanderwildwood.soramoyo.fakealerts"
            android:exported="false" />
        <provider
            android:name=".alerts.FakeForecast"
            android:authorities="com.wanderwildwood.soramoyo.fakeforecast"
            android:exported="false" />
    </application>
</manifest>
