<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The station on the local network, the forecast, and the radar tiles. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Where to centre the radar and whose forecast to fetch, read from AOSP's
         LocationManager: the Kompakt has no Play Services. Asked for on first use, not at
         install, and the station screen works without it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- A Tempest hub broadcasts its readings on the home network; Android throws broadcast
         packets away to save battery unless an app holding this asks to hear them. Only held
         while Sky is listening for one. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- A notification when a serious weather alert is issued for your place; only while that
         setting is on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- What this app means to look for on the phone. Without it, asking whether anything
         can open a web address quietly answers no from Android 11 onwards, however many
         browsers are installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
        No cleartext traffic is declared: Android refuses plain http for the whole app. An Ecowitt
        gateway or a Davis WeatherLink Live serves plain http and nothing else, on the home network
        at an address only its owner knows, which a network security config cannot name ("any
        private address" does not exist there). So net/LocalHttp.kt makes that one request itself,
        over a socket, and only to an address that resolves to a private one. Everything on the
        internet is asked over https.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_mudita"
        android:roundIcon="@drawable/ic_launcher_mudita"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- The weather for Glance's lock-screen panel; it answers Glance alone. -->
        <provider
            android:name=".glance.NowOnLockScreen"
            android:authorities="com.wanderwildwood.soramoyo.glance"
            android:exported="true" />

        <!-- One line of weather for Clock's ringing screen; it answers Clock alone. -->
        <provider
            android:name=".glance.ForTheAlarm"
            android:authorities="com.wanderwildwood.soramoyo.alarm"
            android:exported="true" />

        <!-- Today's weather in plain words, for one other app of ours alone. -->
        <provider
            android:name=".glance.ForTheWalk"
            android:authorities="com.wanderwildwood.soramoyo.sanpo"
            android:exported="true" />
    </application>

</manifest>
