    <!-- About -->
    <!-- %1$s is the version -->
    <string name="about_title">Sky %1$s</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy">Your places and settings stay on this phone. The app goes online only to fetch weather. The phone\'s position, rounded to about a kilometre, or the place you chose, goes to Open-Meteo for the forecast, air quality and pollen, to RainViewer for the radar and to the US National Weather Service for alerts. The words you search a place by go to Open-Meteo. None of these requests carries an account or anything you have written.</string>
    <string name="about_privacy_where">An Ecowitt, Davis or Tempest station is read on your own network. A Weather Underground station is read from Weather Underground, with your station ID and API key. The position is asked for only when you press the button for it, and not at all while you have chosen a place. Notifications are used only for serious weather alerts, when you turn them on; the app then checks every half hour in the background.</string>
    <string name="about_privacy_phone">Other apps of the author\'s on this phone, Glance, Clock and Wander, can ask Sky for the weather and get it, never your position. The lock-screen setting turns Glance off. The links here open in your browser; the app never fetches those pages.</string>
    <string name="about_privacy_close">There are no ads, no analytics and no tracking.</string>
    <string name="about_terms_title">Terms</string>
    <string name="about_terms">This app is free software under the GNU General Public License v3. It comes with no warranty: use it at your own risk. Forecasts can be wrong; do not rely on them for your safety.</string>
    <string name="about_source">Source code: %1$s</string>
    <string name="about_licence">GNU General Public License v3</string>
    <string name="about_after">The radar and its map are kRadar\'s, by Ondřej Koloničný, GPL 3.</string>
    <string name="about_data">Radar by RainViewer. Forecast by Open-Meteo, CC BY 4.0. Alerts by the US National Weather Service. Borders and cities from Natural Earth, public domain.</string>
    <string name="about_icons">Icons from Material Symbols, Apache 2.0</string>
    <string name="about_feed_the_llamas">feed the llamas</string>
    <!-- Shown in place of the llama row when nothing on the phone opens web pages; %1$s is the address -->
