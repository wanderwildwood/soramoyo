    <!-- About -->
    <!-- %1$s is the version -->
    <string name="about_title">Sky %1$s</string>
    <string name="about_privacy">An Ecowitt, Tempest or Davis station is read on your own network. A Weather Underground station is read from Weather Underground, with your API key. The phone\'s position, to about a kilometre, or the place you chose, goes to Open-Meteo for the forecast and to RainViewer for the radar; a place you search for goes to Open-Meteo. Nothing else leaves the phone.</string>
